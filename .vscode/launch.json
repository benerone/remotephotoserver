{
  "version": "0.2.0",
  "configurations": [
    {
      // The Go extension rebuilds the program before every launch.
      "name": "Run server",
      "type": "go",
      "request": "launch",
      "mode": "auto",
      "program": "${workspaceFolder}",
      "args": ["-port", "8443"],
      "console": "integratedTerminal"
    },
    {
      "name": "Run tests",
      "type": "go",
      "request": "launch",
      "mode": "test",
      "program": "${workspaceFolder}"
    }
  ]
}
